/*
 * SD card wired over SPI to the DK's expansion connector, using spi22
 * (labeled "nordic_expansion_spi" and already fully pin-configured in
 * Nordic's own board file, nrf54l_05_10_15_cpuapp_common.dtsi) -- so this
 * overlay does NOT redefine pinctrl or cs-gpios, it only enables the node
 * and adds the SD-over-SPI child nodes on top of Nordic's existing config.
 *
 * Per the nRF54L15 DK Hardware User Guide (v0.9.1) pin maps and
 * nrf54l15dk_nrf54l_05_10_15-pinctrl.dtsi, wire the SD breakout module to:
 *   SCK  -> P1.11  (free GPIO on the P1 header, no other function)
 *   MISO -> P1.07  (shared with UART1_RXD -- freed by disabling &uart30
 *                    below, since spi22 and UART30 share these pins)
 *   MOSI -> P1.06  (shared with UART1_RST -- same as above)
 *   CS   -> P1.10  (Nordic's own default cs-gpios for this node -- this
 *                    pin is ALSO wired to LED1. LEDs on this DK are driven
 *                    through a transistor buffer, not directly from the
 *                    GPIO, so this is a harmless cosmetic side effect
 *                    (LED1 will flicker with SPI CS activity), not a
 *                    electrical conflict.)
 *   3V3  -> any VDDIO/VCC pin on P0/P1/P2 (see the DK's silkscreen)
 *   GND  -> any GND pin on P0/P1/P2
 *
 * These come directly from Nordic's own default overlay for this exact
 * node (grep ~/ncs/v3.4.0/zephyr/boards/nordic/nrf54l15dk/ for
 * "nordic_expansion_spi") -- not guessed. Double-check against the DK's
 * physical silkscreen labels before wiring, since header pin *positions*
 * on the physical connector are not verified here, only the P1.xx ->
 * function mapping from Nordic's documentation and devicetree source.
 */

&uart30 {
	status = "disabled";
};

&spi22 {
	status = "okay";

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		/* Lowered from 24MHz: "Bad data CRC" / disk_access_init -134 at
		 * 24MHz on breadboard/jumper-wire wiring -- classic signal
		 * integrity issue at that speed over loose wiring, not a
		 * protocol bug (identification already succeeds fine before
		 * this). Raise again once wiring is more robust (soldered,
		 * shorter leads) if higher throughput is needed. */
		spi-max-frequency = <4000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
