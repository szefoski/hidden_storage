# Zephyr/west build output (regenerated by `west build`)
firmware/build/
build/

# Python
host/__pycache__/
**/__pycache__/
*.pyc
host/.venv/
.venv/

# Card images / captured dumps -- these can be large and may contain
# whatever was read off the SD card; keep them local, not in git.
*.img
*.bin

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
